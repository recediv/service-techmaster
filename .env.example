NEXT_TELEMETRY_DISABLED=1
# Leave empty locally and for a custom domain.
# For a project on GitHub Pages: NEXT_PUBLIC_BASE_PATH=/repository-name
NEXT_PUBLIC_BASE_PATH=
# Optional canonical origin for a future production build.
# Local previews remain excluded from indexing by default.
SITE_ORIGIN=http://localhost:3000
SITE_INDEXABLE=false
